{
  "name": "openworker-agent-workforce",
  "private": true,
  "type": "module",
  "description": "Enterprise agent workforce built on a replaceable agent harness",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "orchestrate": "node --disable-warning=ExperimentalWarning src/cli/main.ts orchestrate",
    "assess": "node --disable-warning=ExperimentalWarning src/cli/main.ts assess",
    "resume": "node --disable-warning=ExperimentalWarning src/cli/main.ts resume",
    "usage": "node --disable-warning=ExperimentalWarning src/cli/main.ts usage",
    "runs": "node --disable-warning=ExperimentalWarning src/cli/main.ts runs",
    "agent": "node --disable-warning=ExperimentalWarning src/cli/main.ts run",
    "registry": "node --disable-warning=ExperimentalWarning src/cli/main.ts registry",
    "ask": "node --disable-warning=ExperimentalWarning src/cli/main.ts ask",
    "anchor-ledger": "node --disable-warning=ExperimentalWarning src/cli/main.ts anchor-ledger",
    "verify-ledger": "node --disable-warning=ExperimentalWarning src/cli/main.ts verify-ledger"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@openworkerai/harness-sdk": "0.1.0-beta.4",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3"
  }
}
